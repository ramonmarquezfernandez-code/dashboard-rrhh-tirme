# Variables del backend Flask (copiar a .env en esta misma carpeta).
FLASK_APP=app.py
FLASK_DEBUG=1

# Deben coincidir con el .env de la raíz (docker compose)
DB_USER=rrhh_user
DB_PASSWORD=cambia_esta_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epartes_local

# Genera una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_secreta
# Clave para firmar los JWT, mínimo 32 caracteres (si se deja vacía se usa SECRET_KEY).
# Genérala igual que SECRET_KEY.
JWT_SECRET_KEY=

# Base de datos vacía que usan los tests (la crea docker compose)
TEST_DB_NAME=epartes_test

# Carpeta con los CSV exportados (solo para cargar_csv.py, opcional)
CSV_DIR=
