<mxfile host="app.diagrams.net"><diagram name="Modelo de datos"><mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="userpayroll" value="&lt;div style=&quot;background:#0d2f38;color:#fff;font-weight:bold;padding:6px&quot;&gt;userpayroll · empleados&lt;/div&gt;&lt;table style=&quot;width:100%;font-size:11px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;color:#b45309;font-weight:bold&quot;&gt;🔑 ID&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;bigint autoincremental&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;NUMPER&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;varchar(8) · nº de personal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;NAME, SURNAME, EMAIL&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;datos del empleado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;PASSWORD&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;hash bcrypt (60 car.)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;ACTIVE&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;bit · alta / baja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#1d4ed8;font-weight:bold&quot;&gt;↗ GRUPO&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;→ grupospayroll&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#1d4ed8;font-weight:bold&quot;&gt;↗ AREA, DEPARTMENT&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;→ áreas / departamentos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#1d4ed8;font-weight:bold&quot;&gt;↗ CLASSIFICATION_ID&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;→ categoría profesional&lt;/td&gt;&lt;/tr&gt;&