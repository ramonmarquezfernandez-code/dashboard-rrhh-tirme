ight&quot;&gt;→ zperiodos (periodo de nómina)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#1d4ed8;font-weight:bold&quot;&gt;↗ STAT&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;→ eppartstatus (estado A…I)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#1d4ed8;font-weight:bold&quot;&gt;↗ CODGR&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;→ grupospayroll (grupo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;DPTO, CATEG, TIPODIA&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;departamento, categoría, L/S/D/F&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;HN, HNDEC&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;presencia: horas / HHMMSS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;DL…NF + C, B, BN, CO, COP, F&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;28 columnas de horas extra&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;LLDL…LLNF&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;número de llamadas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;MOTIVOHE…MOTHECOP&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;motivo de cada bloque&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;SP, SUST, BLV… (char 1)&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;marcas &amp;#x27;X&amp;#x27; / vacío&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:normal&quot;&gt;ART21DESC, DESCANSO, TELETRABAJO&lt;/td&gt;&lt;td style=&quot;color:#64748b;text-align:right&quot;&gt;situación &amp;#x27;t&amp;#x27; / &amp;#x27;f&amp;#x27;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#334155;font-weight:n